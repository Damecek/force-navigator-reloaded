{
  "name": "force-navigator-reloaded",
  "version": "5.14.13",
  "scripts": {
    "build": "rm -rf dist && webpack --mode production",
    "dev-build": "webpack --mode development",
    "dev": "webpack --mode development --watch",
    "test": "node --test tests/*.test.js",
    "lint": "eslint \"src/**/*.js\"",
    "lint-fix": "eslint \"src/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.{js,json,md,html}\"",
    "store-screenshots": "node ./scripts/renderStoreScreenshots.mjs",
    "release": "sh ./scripts/release.sh",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.28.6",
    "@babel/preset-env": "7.29.7",
    "@lwc/eslint-plugin-lwc": "3.5.0",
    "@lwc/eslint-plugin-lwc-platform": "6.3.0",
    "@lwc/module-resolver": "9.3.4",
    "@salesforce/eslint-config-lwc": "4.1.2",
    "@salesforce/eslint-plugin-lightning": "2.0.0",
    "babel-loader": "10.1.1",
    "copy-webpack-plugin": "14.0.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.15.4",
    "husky": "9.1.7",
    "lwc": "9.3.4",
    "lwc-webpack-plugin": "3.1.0",
    "prettier": "3.9.5",
    "terser-webpack-plugin": "5.6.1",
    "webpack": "5.108.4",
    "webpack-cli": "7.0.2"
  },
  "lint-staged": {
    "*.{js,json,md,html}": "prettier --write"
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  },
  "dependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@leeoniya/ufuzzy": "1.0.19",
    "@webcomponents/custom-elements": "1.6.0",
    "codemirror": "6.0.2"
  },
  "overrides": {
    "@babel/core": "$@babel/core"
  }
}
